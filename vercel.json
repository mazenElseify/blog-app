{
    "version": 2,
    "functions": {
        "api/index.ts": {
            "runtime": "@vercel/node@3"
        }
    },
    "builds": [
        {
            "src": "api/**/*.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api/index.ts"
        }
    ]
}